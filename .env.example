# ── Server ──────────────────────────────────────────────
PORT=3000
# Runtime only (cookies are Secure in production). `vite build` always builds for production.
NODE_ENV="development"

# ── Authentication ──────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET="change-this-to-a-secure-random-string-min-32-chars"

# ── Database ────────────────────────────────────────────
DATABASE_URL="sqlite://./horizonview.db"
# For Docker: DATABASE_URL="sqlite:///app/data/horizonview.db"

# ── CORS ────────────────────────────────────────────────
# Comma-separated allowed origins
ALLOWED_ORIGINS="http://localhost:3000"

# ── Developer Options ───────────────────────────────────
# When enabled, the password reset token is returned in the API response body
# (useful for development without email infrastructure)
SHOW_RESET_TOKEN="true"

# ── External APIs (optional) ────────────────────────────
# Set to "true" to enable email/phone validation during registration
ENABLE_EXTERNAL_VALIDATION="false"

# Get free API keys at:
#   Weather:  https://weatherstack.com
#   Flights:  https://aviationstack.com
#   Phone:    https://numverify.com
#   Email:    https://mailboxlayer.com
#   IP:       https://ipstack.com
#   Currency: https://fixer.io
WEATHERSTACK_API_KEY=""
AVIATIONSTACK_API_KEY=""
NUMVERIFY_API_KEY=""
MAILBOXLAYER_API_KEY=""
IPSTACK_API_KEY=""
FIXER_API_KEY=""
