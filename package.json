{
  "name": "horizonview",
  "version": "1.0.0",
  "description": "Airline Flight & Reservation Management System",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "npm exec tsx -- watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "npm exec tsx -- src/db/migrate.ts",
    "migrate:undo": "npm exec tsx -- src/db/migrate.undo.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "seed": "npm exec tsx -- src/db/seed.ts",
    "seed:flights": "npm exec tsx -- src/db/seed-flights.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "airline",
    "flight",
    "reservation",
    "booking"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.9.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.4",
    "supertest": "^7.2.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.4"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "^0.28.0"
  }
}
