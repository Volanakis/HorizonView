{
  "name": "horizonview",
  "version": "1.0.0",
  "description": "Airline Flight & Reservation Management System",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo \"\"",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "typecheck": "npm run check",
    "lint": "eslint src/ tests/ scripts/",
    "migrate": "tsx src/lib/server/db/migrate.ts",
    "migrate:undo": "tsx src/lib/server/db/migrate.undo.ts",
    "seed": "tsx src/lib/server/db/seed.ts",
    "seed:bulk": "tsx src/lib/server/db/seed-bulk.ts",
    "seed:reservations": "tsx src/lib/server/db/seed-reservations.ts",
    "seed:flights": "tsx src/lib/server/db/seed-flights.ts",
    "make-admin": "node scripts/make-admin.mjs",
    "test": "vite build --logLevel warn && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vite build --logLevel warn && vitest run --coverage"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "airline",
    "flight",
    "reservation",
    "booking"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.9.0",
    "dotenv": "^16.3.1",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "supertest": "^7.2.2",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^7.3.5",
    "vitest": "^3.2.6"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "^0.28.0"
  }
}
